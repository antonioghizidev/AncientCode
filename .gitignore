# Binaries and build artifacts
/ancientcode
/ancientcode.exe
/ancientai
/ancientai.exe
*.test
/dist/

# Secrets — never versioned
.env
.env.*
*.pem
*.key

# Sessions and local state
sessions/
*.log
docs/.obsidian/

# M14: credential store and per-provider model memory (S7). Both live outside
# code_root in normal operation (~/.local/share/ancientcode), but a run from a
# checkout with HOME pointed inside the repo would otherwise stage a live key.
auth.json
state.json
.ancientcode-verified
